{
  "seed": 42,
  "epochs": 16,
  "steps_per_epoch": 512,
  "batch_size": 8,
  "encoder_lr": 5e-06,
  "decoder_lr": 5e-05,
  "weight_decay": 0.0001,
  "water_bce_weight": 0.5,
  "water_dice_weight": 0.5,
  "cloud_bce_weight": 0.1,
  "patience": 4,
  "min_delta": 0.0001,
  "water_threshold": 0.5,
  "selection": "maximum eligible validation pooled water IoU; clear and cloudy each >=baseline minus1 point",
  "target_test_iou": 0.9,
  "train_only": true,
  "training_stride": 256,
  "evaluation_stride": 512,
  "precision": "AMP fp16 training; fp32 validation",
  "augmentation": "random right-angle rotations/flips; gain0.9..1.1 and per-band Gaussian offset std20DN",
  "sampler": "inverse scene tile-count times (1+2*cloudy+mixed-water); replacement",
  "training_events": "exclude evaluation EMSR activations"
}